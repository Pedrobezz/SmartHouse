{
  "name": "casa-3d",
  "productName": "SmartHouse",
  "version": "2.15.0",
  "description": "SmartHouse",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable --publish never",
    "test": "node --test test/*.mjs",
    "test:ui": "bash test/ui/run.sh"
  },
  "author": "SmartHouse",
  "license": "MIT",
  "dependencies": {
    "bonjour-service": "^1.3.0",
    "qrcode": "^1.5.4",
    "tuyapi": "^7.7.1"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.1.0",
    "@fontsource/barlow": "^5.1.0",
    "electron": "^37.2.0",
    "electron-builder": "^25.1.8",
    "three": "0.170.0"
  },
  "build": {
    "appId": "com.casa3d.app",
    "productName": "SmartHouse",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "renderer/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "renderer/assets/icon.ico",
      "signAndEditExecutable": true
    },
    "portable": {
      "artifactName": "SmartHouse-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "SmartHouse-Setup-${version}.exe",
      "shortcutName": "SmartHouse",
      "createDesktopShortcut": true,
      "runAfterFinish": true,
      "installerIcon": "renderer/assets/icon.ico",
      "uninstallerIcon": "renderer/assets/icon.ico"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://updates.invalid/casa3d"
      }
    ]
  }
}
